{
  "name": "dentalia",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma odontológica multiempresa y multisucursal (SaaS) — clínica piloto en Bolivia.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:server": "tsx watch server/src/main.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p server/tsconfig.json",
    "build:web": "vite build --config web/vite.config.ts",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "migrate": "tsx server/src/cli/migrate.ts",
    "seed": "tsx server/src/cli/seed.ts",
    "start": "node server/dist/main.js",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.8",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.10",
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^6.1.3",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.8",
    "luxon": "^3.7.2",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "lucide-react": "^1.71.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
