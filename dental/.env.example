# Copia este archivo a .env (nunca lo subas al repositorio).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/dental_dev
PORT=3100
# Producción: NODE_ENV=production activa cookies Secure y confianza en el proxy.
# NODE_ENV=production
# SESSION_TTL_HOURS=12
# Claves del servidor, separadas por uso (B-094). Obligatorias y distintas en producción.
# Generar cada una con: openssl rand -hex 32 — guardarlas fuera del repositorio y de los respaldos de la base.
#   DENTAL_MFA_KEY : cifra el secreto de la verificación en dos pasos.
#   DENTAL_LINK_KEY: firma enlaces y códigos (archivos, desbloqueo de cuenta, confirmación de citas,
#                    encuestas, QR de llegada, presupuesto por enlace y portal).
# DENTAL_MFA_KEY=
# DENTAL_LINK_KEY=
# Rotación: pon la clave anterior en *_PREVIOUS (solo verifica o descifra) y la nueva en la principal.
# Los secretos de 2 pasos se vuelven a cifrar con la nueva al usarse. Retira *_PREVIOUS cuando
# hayan vencido los enlaces (unas horas) y todo el personal haya ingresado con 2 pasos al menos una vez.
# Si venías usando DENTAL_SECRET_KEY: ponla en DENTAL_MFA_KEY_PREVIOUS y DENTAL_LINK_KEY_PREVIOUS.
# DENTAL_MFA_KEY_PREVIOUS=
# DENTAL_LINK_KEY_PREVIOUS=
# Solo desarrollo: si faltan las claves anteriores, se derivan de DENTAL_SECRET_KEY (o de una clave fija).
# DENTAL_SECRET_KEY=
# URL pública (enlaces de recuperación de contraseña) y correo saliente.
# PUBLIC_URL=https://app.ejemplo.bo
# SMTP_URL=smtps://usuario:clave@smtp.proveedor.com:465
# MAIL_FROM="Clínica <no-responder@ejemplo.bo>"
# Asistente con IA (opcional). Sin esta variable, el asistente funciona solo con acciones rápidas.
# ANTHROPIC_API_KEY=
# Copias de seguridad cifradas (scripts/backup.sh y npm run backup:run). Obligatoria en producción (16+ caracteres).
# Generar con: openssl rand -base64 32 — guardarla FUERA del servidor y de los respaldos (sin ella no se restauran).
# BACKUP_PASSPHRASE=
# Archivos clínicos (radiografías, fotos, documentos escaneados): carpeta privada fuera de web/dist.
# En Docker/Railway, móntala como volumen persistente (p. ej. /data/files); scripts/backup.sh la empaqueta.
# DENTAL_FILES_DIR=./data/files
# Tamaño máximo por archivo, en MB (de 1 a 100).
# DENTAL_FILES_MAX_MB=15

# --- Mensajes automáticos (solo producción; fuera de producción todo queda simulado) ---
# MESSAGING_SCHEDULER=1                 # activa el programador de avisos
# MESSAGING_SCHEDULER_INTERVAL_MS=60000
# WHATSAPP_TOKEN=                       # token de WhatsApp Cloud API de la clínica (gestor de secretos, nunca en el repositorio)
# WHATSAPP_PHONE_ID=
# WHATSAPP_APP_SECRET=                  # firma del webhook /api/webhooks/whatsapp
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_API_VERSION=

# --- Proxy ---
# TRUST_PROXY=1                          # cantidad de proxies delante de la app (Railway: 1). Nunca "true".

# --- Archivos clínicos en almacenamiento S3 compatible (por defecto: disco en DENTAL_FILES_DIR) ---
# DENTAL_FILES_DRIVER=s3
# DENTAL_S3_ENDPOINT=https://<cuenta>.r2.cloudflarestorage.com   # R2; B2: https://s3.<región>.backblazeb2.com; AWS: https://s3.<región>.amazonaws.com
# DENTAL_S3_REGION=auto                  # R2: auto; B2: p. ej. us-west-004; AWS: la región del bucket
# DENTAL_S3_BUCKET=
# DENTAL_S3_ACCESS_KEY_ID=               # en el gestor de secretos del proveedor, nunca en el repositorio
# DENTAL_S3_SECRET_ACCESS_KEY=
# DENTAL_S3_PATH_STYLE=1                 # AWS: 0
# DENTAL_S3_SSE=AES256                   # MinIO sin KMS: off
# DENTAL_S3_CONDITIONAL_PUT=1            # B2 si rechaza If-None-Match: 0
# Activar el versionado del bucket: con S3, backup.sh no empaqueta los archivos.

# --- Respaldo programado y simulacro de restauración (npm run backup:run / backup:verify) ---
# BACKUP_STORAGE=auto                    # auto: S3 si hay BACKUP_S3_* (o DENTAL_S3_*), si no carpeta local; o «s3» / «local»
# BACKUP_DIR=./backups                   # carpeta local (nunca dentro de DENTAL_FILES_DIR); en un contenedor se pierde al redeplegar
# BACKUP_S3_ENDPOINT=                    # si faltan, se usan las DENTAL_S3_* (mismo proveedor)
# BACKUP_S3_REGION=
# BACKUP_S3_BUCKET=                      # recomendado: un bucket distinto del de archivos clínicos (otra cuenta/proveedor, con bloqueo de objetos)
# BACKUP_S3_ACCESS_KEY_ID=               # gestor de secretos, nunca en el repositorio
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_S3_PREFIX=respaldos/            # carpeta propia dentro del bucket: la retención solo borra ahí
# BACKUP_S3_PATH_STYLE=1
# BACKUP_S3_SSE=AES256
# BACKUP_KEEP_DAILY=7                    # retención: últimos 7 días, 4 semanas y 12 meses con respaldo
# BACKUP_KEEP_WEEKLY=4
# BACKUP_KEEP_MONTHLY=12
# BACKUP_PRUNE=1                         # 0: no borrar respaldos antiguos
# BACKUP_PG_BIN=                         # carpeta de pg_dump/pg_restore si no están en el PATH (misma versión mayor que el servidor o más nueva)
# BACKUP_VERIFY_ADMIN_URL=               # servidor donde el simulacro crea la base temporal (por defecto el de DATABASE_URL, base «postgres»)
# BACKUP_VERIFY_DB_PREFIX=dental_restore # la base temporal siempre empieza con dental_restore y se borra al terminar

# --- Monitoreo y alertas a los administradores de la plataforma ---
# OPS_MONITOR=1                          # monitor en el servidor (activo por defecto en producción)
# OPS_MONITOR_INTERVAL_MS=300000
# OPS_SLOW_MS=1000                       # solicitudes más lentas se registran en el log (solo el patrón de ruta)
# ALERT_BACKUP_MAX_AGE_HOURS=26
# ALERT_VERIFY_MAX_AGE_DAYS=8
# ALERT_5XX_THRESHOLD=20                 # errores 5xx en la ventana para alertar
# ALERT_5XX_WINDOW_MINUTES=10
# ALERT_REPEAT_HOURS=6                   # la misma alerta no se repite antes de este tiempo
# ALERT_EMAILS=guardia@ejemplo.bo        # además de los administradores de plataforma (y si la base no responde)
# ALERT_WEBHOOK_URL=                     # https en producción (Slack/Teams/etc. compatible con {"text": ...}); fuera de producción solo 127.0.0.1
# APP_VERSION=                           # versión mostrada en el panel (por defecto la de package.json)
