# Copia este archivo a .env (nunca lo subas al repositorio).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/dental_dev
PORT=3100
# Producción: NODE_ENV=production activa cookies Secure y confianza en el proxy.
# NODE_ENV=production
# SESSION_TTL_HOURS=12
# Clave de 32 bytes para cifrar los secretos de verificación en dos pasos (obligatoria en producción).
# Generar con: openssl rand -hex 32   — guardarla fuera del repositorio y de los respaldos de la base.
# DENTAL_SECRET_KEY=
# URL pública (enlaces de recuperación de contraseña) y correo saliente.
# PUBLIC_URL=https://app.ejemplo.bo
# SMTP_URL=smtps://usuario:clave@smtp.proveedor.com:465
# MAIL_FROM="Clínica <no-responder@ejemplo.bo>"
# Asistente con IA (opcional). Sin esta variable, el asistente funciona solo con acciones rápidas.
# ANTHROPIC_API_KEY=
# Copias de seguridad cifradas (scripts/backup.sh)
# BACKUP_PASSPHRASE=
# Archivos clínicos (radiografías, fotos, documentos escaneados): carpeta privada fuera de web/dist.
# En Docker/Railway, móntala como volumen persistente (p. ej. /data/files); scripts/backup.sh la empaqueta.
# DENTAL_FILES_DIR=./data/files
# Tamaño máximo por archivo, en MB (de 1 a 100).
# DENTAL_FILES_MAX_MB=15

# --- Mensajes automáticos (solo producción; fuera de producción todo queda simulado) ---
# MESSAGING_SCHEDULER=1                 # activa el programador de avisos
# MESSAGING_SCHEDULER_INTERVAL_MS=60000
# WHATSAPP_TOKEN=                       # token de WhatsApp Cloud API de la clínica (gestor de secretos, nunca en el repositorio)
# WHATSAPP_PHONE_ID=
# WHATSAPP_APP_SECRET=                  # firma del webhook /api/webhooks/whatsapp
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_API_VERSION=

# --- Proxy ---
# TRUST_PROXY=1                          # cantidad de proxies delante de la app (Railway: 1). Nunca "true".

# --- Archivos clínicos en almacenamiento S3 compatible (por defecto: disco en DENTAL_FILES_DIR) ---
# DENTAL_FILES_DRIVER=s3
# DENTAL_S3_ENDPOINT=https://<cuenta>.r2.cloudflarestorage.com   # R2; B2: https://s3.<región>.backblazeb2.com; AWS: https://s3.<región>.amazonaws.com
# DENTAL_S3_REGION=auto                  # R2: auto; B2: p. ej. us-west-004; AWS: la región del bucket
# DENTAL_S3_BUCKET=
# DENTAL_S3_ACCESS_KEY_ID=               # en el gestor de secretos del proveedor, nunca en el repositorio
# DENTAL_S3_SECRET_ACCESS_KEY=
# DENTAL_S3_PATH_STYLE=1                 # AWS: 0
# DENTAL_S3_SSE=AES256                   # MinIO sin KMS: off
# DENTAL_S3_CONDITIONAL_PUT=1            # B2 si rechaza If-None-Match: 0
# Activar el versionado del bucket: con S3, backup.sh no empaqueta los archivos.
