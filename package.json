{
  "name": "vendeplay-sdk",
  "version": "0.1.0",
  "description": "SDK TypeScript (reverse-engineered) para la API de VendePlay CRM. Rutas, verbos y auth derivados por análisis estático del front-end; formas de payload no verificadas.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "openapi.yaml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test",
    "validate:openapi": "node -e \"import('@apidevtools/swagger-parser').then(m=>m.default.validate('openapi.yaml')).then(a=>console.log('OpenAPI VALID',a.info.version)).catch(e=>{console.error(e.message);process.exit(1)})\"",
    "gen:postman": "node scripts/gen-postman.mjs",
    "example": "node --experimental-strip-types examples/demo.ts"
  },
  "keywords": [
    "vendeplay",
    "crm",
    "sdk",
    "reverse-engineered"
  ],
  "license": "MIT",
  "devDependencies": {
    "@apidevtools/swagger-parser": "^10.1.1",
    "js-yaml": "^4.3.2",
    "openapi-to-postmanv2": "^4.25.0",
    "typescript": "^5.6.0"
  }
}
